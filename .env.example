# Public site configuration (set at build/deploy time)
SITE_URL=

# Client-visible values only; never put server keys in a PUBLIC_ variable
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_FINANCE_OS_API_BASE=

# Cloudflare Worker secrets (set in Cloudflare dashboard or with wrangler secret put)
BUILDER_PUBLIC_API_KEY=
BUILDER_PAT=
SUPABASE_SERVICE_ROLE_KEY=
BEA_API_KEY=
EIA_API_KEY=
FRED_API_KEY=
INGEST_TOKEN=

# Cloudflare Worker non-secret variable
SUPABASE_URL=
ALLOWED_ORIGINS=
