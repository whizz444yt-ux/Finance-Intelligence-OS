# Public site configuration (set at build/deploy time)
SITE_URL=

# Client-visible values only; never put server keys in a PUBLIC_ variable
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_FINANCE_OS_API_BASE=

# Cloudflare Worker secrets (set with `wrangler secret put`, do not commit values)
BUILDER_PUBLIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_TOKEN=
ALLOWED_ORIGINS=
